---
// On-demand so ?servicio= / ?producto= / ?proyecto= can preset the form.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Photo from '../components/ui/Photo.astro';
import QuoteStepper from '../components/forms/QuoteStepper';
import { getProduct } from '../data/products';
import { productImage } from '../lib/images';

const q = Astro.url.searchParams;
const product = q.get('producto') ? getProduct(q.get('producto')!) : undefined;
const service = q.get('servicio') ?? undefined;
const projectRef = q.get('proyecto') ?? undefined;
const perks = ['Respuesta en 24 h', 'Visita técnica sin costo en Chiclayo', 'Precios de distribuidor directo'];
---
<BaseLayout title="Cotizar gratis" description="Cuéntanos qué necesitas y recibe tu cotización de aire acondicionado en menos de 24 horas.">
  <section class="mx-auto grid max-w-[1440px] gap-10 px-4 pb-24 pt-12 sm:px-8 lg:grid-cols-[420px_1fr] lg:gap-16 lg:px-[120px]">
    <div class="flex flex-col gap-6">
      <Eyebrow>Cotización gratis</Eyebrow>
      <h1 class="text-display-l">Cuéntanos qué necesitas</h1>
      <p class="text-body-l text-muted">Te enviamos una cotización detallada en menos de 24 horas. Sin compromiso.</p>
      <ul class="flex flex-col gap-2 text-label">{perks.map((p) => <li>✓ {p}</li>)}</ul>
      {(product || projectRef) && (
        <div class="flex items-center gap-3 rounded-[18px] bg-surface p-3 pr-4">
          <Photo src={product ? productImage(product.slug) : undefined} alt="" fit="contain" sizes="56px" class="size-14 shrink-0 rounded-xl !bg-canvas" />
          <div><p class="text-caption text-muted">Cotizando</p><p class="text-label">{product?.name ?? `Proyecto similar a ${projectRef}`}</p></div>
        </div>
      )}
    </div>
    <div class="rounded-[32px] bg-surface p-6 shadow-[var(--shadow-float)] sm:p-10">
      <QuoteStepper client:load service={service} product={product?.slug} productName={product?.name} projectRef={projectRef} />
    </div>
  </section>
</BaseLayout>
