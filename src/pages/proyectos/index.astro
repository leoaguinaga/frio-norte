---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { getProjects } from '../../lib/contralio';
const projects = await getProjects();
---
<BaseLayout title="Proyectos de climatización" description="Instalaciones de aire acondicionado en salud, banca, educación, retail e industria en todo el Perú.">
  <PageHeader eyebrow="Proyectos" title="500+ instalaciones en todo el Perú" subtitle="Salud, banca, educación, retail e industria. Cada proyecto, documentado." crumbs={[{ label: 'Proyectos' }]} />
  <ProjectGrid projects={projects} />
</BaseLayout>
