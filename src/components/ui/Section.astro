---
interface Props { id?: string; class?: string; tight?: boolean; as?: 'section' | 'div' }
const { id, class: cls, tight = false, as: Tag = 'section' } = Astro.props;
---
<Tag id={id} class:list={['mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-[120px]', tight ? 'py-12 lg:py-16' : 'py-20 lg:py-28', cls]}>
  <slot />
</Tag>
