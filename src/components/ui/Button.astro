---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary' | 'brand' | 'inverse';
  size?: 'md' | 'lg';
  full?: boolean;
} & HTMLAttributes<'a'> & HTMLAttributes<'button'>;

const { href, variant = 'primary', size = 'md', full, class: cls, ...rest } = Astro.props;

const variants = {
  primary: 'bg-ink text-white hover:bg-ink/90',
  secondary: 'bg-surface text-ink ring-1 ring-line hover:ring-ink/30',
  brand: 'bg-primary text-white hover:bg-primary/90',
  inverse: 'bg-white/10 text-white ring-1 ring-white/25 hover:bg-white/15',
};
const sizes = { md: 'h-10 px-[18px] text-label', lg: 'h-12 px-6 text-[15px] font-medium' };
const classes = [
  'inline-flex items-center justify-center gap-2 rounded-full whitespace-nowrap select-none',
  'transition-[transform,background-color,box-shadow] duration-150 ease-out active:scale-[0.97]',
  variants[variant], sizes[size], full && 'w-full', cls,
];
const Tag = href ? 'a' : 'button';
---
<Tag href={href} class:list={classes} {...rest}><slot /></Tag>
