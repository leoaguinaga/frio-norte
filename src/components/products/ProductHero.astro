---
import Photo from '../ui/Photo.astro';
import { productImage } from '../../lib/images';
import Eyebrow from '../ui/Eyebrow.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Button from '../ui/Button.astro';
import Price from '../ui/Price.astro';
import { typeLabel, type Product } from '../../data/products';
import { whatsappLink } from '../../data/site';
const { product: p } = Astro.props as { product: Product };
---
<section class="mx-auto grid max-w-[1440px] gap-10 px-4 pb-16 pt-8 sm:px-8 lg:grid-cols-[1fr_520px] lg:gap-16 lg:px-[120px]">
  <Photo src={productImage(p.slug)} alt={`${p.name}, vista frontal`} eager fit="contain" sizes="(min-width:1024px) 680px, 100vw" class="aspect-[5/4] h-fit rounded-[28px] !bg-surface lg:sticky lg:top-28" />
  <div class="flex flex-col gap-5">
    <Breadcrumbs items={[{ label: 'Equipos', href: '/productos' }, { label: typeLabel(p.type), href: `/productos?tipo=${p.type}#catalogo` }, { label: p.name }]} />
    <Eyebrow>{p.brand} · {typeLabel(p.type)}</Eyebrow>
    <h1 class="text-display-l">{p.name}</h1>
    <p class="text-body-l text-muted text-pretty">{p.summary}</p>
    <fieldset class="flex flex-col gap-2.5">
      <legend class="mb-2.5 text-label">Capacidad</legend>
      <div class="flex flex-wrap gap-2">
        {p.capacities.map((c, i) => (
          <label class="cursor-pointer rounded-full bg-surface px-4 py-2 text-caption transition-colors has-[:checked]:bg-ink has-[:checked]:text-white">
            <input type="radio" name="cap" value={c} checked={i === 0} class="sr-only" />{c.toLocaleString('en-US')} BTU
          </label>
        ))}
      </div>
    </fieldset>
    <div class="flex flex-col gap-3 rounded-3xl bg-surface p-6">
      <Price value={p.price} label="Precio desde" size="lg" />
      <p class="text-sm text-muted">El precio final depende de la distancia entre unidades y el tipo de muro. Te enviamos la cotización exacta por WhatsApp.</p>
      <Button href={`/cotizar?producto=${p.slug}`} size="lg" full>Cotizar con instalación</Button>
      <Button href={whatsappLink(`Hola, quiero cotizar el ${p.name}`)} variant="secondary" size="lg" full target="_blank" rel="noopener">Consultar por WhatsApp</Button>
    </div>
    <p class="flex flex-wrap gap-5 text-caption text-muted"><span>✓ Garantía de marca</span><span>✓ Instalación certificada</span></p>
  </div>
</section>
