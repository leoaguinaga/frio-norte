---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { brands } from '../../data/products';
---
<Section class="!pt-0">
  <div class="grid gap-4 lg:grid-cols-[1fr_460px]">
    <div class="flex flex-col gap-5 rounded-[28px] bg-surface p-8" data-reveal>
      <h2 class="text-h4">Distribuidores autorizados</h2>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {brands.map((b) => <li class="flex flex-col items-center gap-1 rounded-[18px] bg-canvas py-6"><span class="text-h3">{b.name}</span>{b.note && <span class="text-caption text-secondary">{b.note}</span>}</li>)}
      </ul>
      <p class="text-sm text-muted">Garantía de fábrica + garantía de instalación Frío Norte, por escrito.</p>
    </div>
    <div class="flex flex-col gap-4 rounded-[28px] bg-secondary p-8 text-white" data-reveal style="--i:1">
      <h2 class="text-h3">¿Edificio, clínica o planta?</h2>
      <p class="text-white/85">Multi V, chillers y ductos se diseñan a medida. Habla con un ingeniero de proyectos.</p>
      <Button href="/cotizar?servicio=Asesor%C3%ADa%20de%20proyectos" variant="secondary" size="lg" full class="mt-auto">Hablar con un ingeniero</Button>
    </div>
  </div>
</Section>
