---
// Line diagrams showing how each unit type sits in a room (from Figma).
import type { InstallType } from '../../data/products';
const { type } = Astro.props as { type: InstallType };
const B = 'var(--color-primary)', G = 'var(--color-secondary)', L = '#B9C7D6';
---
<svg width="200" height="120" viewBox="0 0 200 120" fill="none" aria-hidden="true" class="h-auto w-full max-w-[200px]">
  {type === 'vrf' ? (
    <>
      <rect x="50" y="20" width="100" height="92" rx="4" stroke={L} stroke-width="1.5" stroke-dasharray="4 4" />
      <path d="M50 50H150M50 80H150" stroke={L} stroke-width="1.5" stroke-dasharray="4 4" />
      <rect x="86" y="6" width="28" height="14" rx="3" fill="white" stroke={B} stroke-width="2" />
      <path d="M100 20V100M84 34H100M100 64H116M84 94H100" stroke={B} stroke-width="1.5" />
      <rect x="62" y="30" width="22" height="8" rx="2" fill="white" stroke={B} stroke-width="1.5" />
      <rect x="116" y="60" width="22" height="8" rx="2" fill="white" stroke={B} stroke-width="1.5" />
      <rect x="62" y="90" width="22" height="8" rx="2" fill="white" stroke={B} stroke-width="1.5" />
    </>
  ) : (
    <>
      <path d="M10 14H190M10 14V112M190 14V112M10 112H190" stroke={L} stroke-width="1.5" stroke-dasharray="4 4" />
      {type === 'split' && <><rect x="60" y="28" width="80" height="22" rx="6" fill="white" stroke={B} stroke-width="2" /><path d="M70 44H130" stroke={B} stroke-width="2" /><path d="M75 58c4 6 4 12 0 18M100 58c4 6 4 12 0 18M125 58c4 6 4 12 0 18" stroke={G} stroke-width="1.5" stroke-linecap="round" /></>}
      {type === 'cassette' && <><rect x="62" y="14" width="76" height="12" rx="3" fill="white" stroke={B} stroke-width="2" /><rect x="74" y="17" width="52" height="6" rx="2" stroke={B} stroke-width="1.5" /><path d="M70 32l-12 14M130 32l12 14M100 32v18" stroke={G} stroke-width="1.5" stroke-linecap="round" /></>}
      {type === 'techo' && <><path d="M70 14v8M130 14v8" stroke={B} stroke-width="2" /><rect x="56" y="22" width="88" height="20" rx="8" fill="white" stroke={B} stroke-width="2" /><path d="M80 50c6 8 6 14 0 22M120 50c6 8 6 14 0 22" stroke={G} stroke-width="1.5" stroke-linecap="round" /></>}
      {type === 'ventana' && <><rect x="70" y="46" width="60" height="40" rx="4" fill="white" stroke={B} stroke-width="2" /><path d="M78 56H122M78 62H122M78 68H122" stroke={B} stroke-width="1.5" /></>}
      {type === 'portatil' && <><rect x="84" y="60" width="32" height="52" rx="6" fill="white" stroke={B} stroke-width="2" /><path d="M116 72c20 0 30-10 40-30" stroke={B} stroke-width="2" stroke-dasharray="3 3" /></>}
    </>
  )}
</svg>
