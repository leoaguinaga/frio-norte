---
import Photo from '../ui/Photo.astro';
import { productImage } from '../../lib/images';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Price from '../ui/Price.astro';
import { formatBtu, typeLabel, type Product } from '../../data/products';
const { product: p } = Astro.props as { product: Product };
const f = p.featured!;
const specs = [[`${formatBtu(p.capacities[0])}–${formatBtu(p.capacities.at(-1)!)}`, 'BTU/h'], [String(f.seer), 'SEER'], [String(f.db), 'dB mín.'], [f.area, 'm²']];
---
<article class="grid items-center gap-8 rounded-[28px] bg-surface p-3 lg:grid-cols-[300px_1fr_260px] lg:gap-10 lg:pr-10" data-reveal>
  <Photo src={productImage(p.slug)} alt={p.name} fit="contain" sizes="(min-width:1024px) 300px, 100vw" class="aspect-[5/4] rounded-[20px] !bg-canvas" />
  <div class="flex flex-col gap-2.5 px-3 lg:px-0">
    <Badge tone={f.badge === 'Mejor ahorro' ? 'secondary' : 'primary'}>{f.badge}</Badge>
    <h3 class="text-h3"><a href={`/productos/${p.slug}`} class="hover:text-primary">{p.name}</a></h3>
    <p class="text-caption text-muted">{typeLabel(p.type)} · {p.mode}</p>
    <p class="max-w-[360px] text-sm text-muted">{p.summary}</p>
    <dl class="mt-1 grid w-fit grid-cols-4 divide-x divide-line rounded-2xl ring-1 ring-line">
      {specs.map(([v, l]) => <div class="px-4 py-3"><dd class="font-mono text-xl font-medium tracking-tight">{v}</dd><dt class="text-caption text-muted">{l}</dt></div>)}
    </dl>
  </div>
  <div class="flex flex-col gap-3.5 px-3 pb-3 lg:p-0">
    <Price value={p.price} size="md" />
    <hr class="border-line" />
    <p class="text-caption text-muted">Ahorro vs. equipo convencional</p>
    <p class="flex items-baseline gap-1.5"><span class="font-mono text-[40px] font-medium leading-none tracking-tight text-secondary">{f.savings}%</span><span class="text-sm text-muted">menos consumo</span></p>
    <div class="h-2 rounded-full bg-surface-muted"><div class="bar h-full rounded-full bg-secondary" style={`--w:${f.savings}%`}></div></div>
    <Button href={`/cotizar?producto=${p.slug}`} full>Cotizar con instalación</Button>
    <Button href={`/productos/${p.slug}`} variant="secondary" full>Ver ficha técnica</Button>
  </div>
</article>
