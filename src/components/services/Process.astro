---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
const steps = [
  ['Cotización', 'Nos cuentas tu necesidad y respondemos en 24 h.'],
  ['Visita técnica', 'Medimos el espacio y calculamos la carga térmica.'],
  ['Instalación', 'Técnicos certificados, limpieza y prueba final.'],
  ['Mantenimiento', 'Te recordamos cada servicio y llevamos el historial.'],
];
---
<Section>
  <SectionHeader eyebrow="Cómo trabajamos" title="Del primer mensaje a tu equipo funcionando" />
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map(([t, d], i) => (
      <li class="flex flex-col gap-2.5 rounded-3xl bg-surface p-7" data-reveal style={`--i:${i}`}>
        <span class="text-caption text-primary">Paso {i + 1}</span>
        <h3 class="text-h4">{t}</h3>
        <p class="text-sm text-muted">{d}</p>
      </li>
    ))}
  </ol>
</Section>
