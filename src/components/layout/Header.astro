---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { nav } from '../../data/site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 px-4 pt-4 sm:px-6">
  <div class="mx-auto flex max-w-[1408px] items-center justify-between gap-4 rounded-full py-2 pl-5 pr-2 transition-[background-color,box-shadow,backdrop-filter] duration-300 ease-[var(--ease-out-strong)]" data-header>
    <Logo />
    <nav aria-label="Principal" class="hidden items-center gap-1 rounded-full bg-surface/85 p-1.5 pl-4 shadow-[var(--shadow-float)] backdrop-blur-xl backdrop-saturate-150 md:flex">
      {nav.map((l) => (
        <a href={l.href} class:list={['rounded-full px-3 py-2 text-label transition-colors hover:text-primary', path.startsWith(l.href) && 'text-primary']}>{l.label}</a>
      ))}
      <Button href="/cotizar" class="ml-2">Cotizar gratis</Button>
    </nav>
    <details class="relative md:hidden">
      <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-full bg-surface shadow-[var(--shadow-float)]" aria-label="Abrir menú">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <div class="absolute right-0 mt-2 flex w-60 origin-top-right flex-col gap-1 rounded-3xl bg-surface p-3 shadow-[var(--shadow-float)]">
        {nav.map((l) => <a href={l.href} class="rounded-2xl px-4 py-3 text-label hover:bg-canvas">{l.label}</a>)}
        <Button href="/cotizar" full class="mt-1">Cotizar gratis</Button>
      </div>
    </details>
  </div>
</header>

<script>
  // Give the bar a translucent material once content scrolls under it.
  const bar = document.querySelector<HTMLElement>('[data-header]')!;
  const sync = () => bar.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', sync, { passive: true });
  sync();
</script>

<style>
  /* Explicit zero blur so the filter interpolates instead of snapping from `none`. */
  [data-header] { backdrop-filter: blur(0px) saturate(100%); }
  [data-header][data-scrolled] {
    background: rgb(255 255 255 / 0.72);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow: var(--shadow-float);
  }
  @media (prefers-reduced-transparency: reduce) {
    [data-header][data-scrolled] { background: white; backdrop-filter: none; }
  }
</style>
