---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import ProductCard from '../products/ProductCard.astro';
import { products } from '../../data/products';
---
<Section>
  <SectionHeader eyebrow="Equipos" title="El equipo correcto para cada espacio">
    <Button href="/productos" variant="secondary">Ver catálogo</Button>
  </SectionHeader>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {products.slice(0, 4).map((p, i) => <ProductCard product={p} i={i} />)}
  </div>
</Section>
