---
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import Photo from "../ui/Photo.astro";
import QuoteForm from "../forms/QuoteForm";
import { images } from "../../lib/images";
---

<section class="px-4 pt-2">
  <Photo
    src={images.hero}
    alt="Técnicos de Frío Norte instalando una unidad condensadora en una azotea de Chiclayo"
    eager
    sizes="100vw"
    position="object-[70%_center]"
    class="mx-auto max-w-[1408px] rounded-[var(--radius-panel)]"
  >
    <div
      class="absolute inset-0 bg-linear-to-b from-canvas/40 via-canvas/20 to-transparent lg:bg-linear-to-r lg:from-canvas/90 lg:from-20% lg:via-canvas/60 lg:via-35% lg:to-transparent lg:to-60%"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative grid gap-10 px-6 py-14 sm:px-12 lg:grid-cols-[1fr_360px] lg:items-end lg:px-16 lg:py-24"
    >
      <div class="flex max-w-[620px] flex-col gap-7">
        <Eyebrow>Distribuidor autorizado LG en el norte</Eyebrow>
        <h1 class="text-display-xl text-balance">
          Climatización confiable para todo el año
        </h1>
        <p
          class="max-w-[440px] text-body-l text-ink text-pretty [text-shadow:0_0_12px_var(--color-canvas),0_0_2px_var(--color-canvas)]"
        >
          Vendemos, instalamos y mantenemos equipos LG, Daikin y York para
          hogares, empresas e industria. Cotización en 24 horas.
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href="/cotizar" size="lg">Cotizar gratis</Button>
          <Button href="/servicios" variant="secondary" size="lg"
            >Ver servicios</Button
          >
        </div>
        <div class="mt-6 flex flex-col gap-1.5">
          <div class="flex -space-x-2" aria-hidden="true">
            {
              [0, 1, 2].map(() => (
                <span class="size-7 rounded-full border-2 border-surface bg-surface-muted" />
              ))
            }
            <span class="size-7 rounded-full border-2 border-surface bg-primary"
            ></span>
          </div>
          <p class="text-label">500+ proyectos instalados</p>
          <p class="text-caption text-muted">
            Empresas y hogares del norte del Perú
          </p>
        </div>
      </div>
      <div
        class="rounded-3xl bg-surface/85 p-6 shadow-[var(--shadow-float)] backdrop-blur-sm"
      >
        <QuoteForm client:idle />
      </div>
    </div>
  </Photo>
</section>
