---
import { Image } from "astro:assets";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { partners } from "../../data/home";
import lg from "../../assets/images/brands/lg.png";
import midea from "../../assets/images/brands/midea.webp";

const logos = { lg, midea } as const;
---

<div class="bg-surface">
  <Section>
    <SectionHeader
      center
      eyebrow="Partners"
      title="Respaldo directo de las marcas que instalamos"
      subtitle="Como partners autorizados de LG y Midea, cada equipo que instalamos llega con garantía de fábrica, repuestos originales y técnicos capacitados por la marca."
    />
    <div class="grid gap-4 md:grid-cols-2">
      {partners.map((p, i) => (
        <article
          class="flex flex-col gap-8 rounded-panel bg-canvas p-7 lg:p-10"
          data-reveal
          style={`--i:${i}`}
        >
          <div class="flex items-center justify-between gap-4">
            <div class="grid h-20 place-items-center rounded-2xl bg-surface px-6">
              <Image
                src={logos[p.logo as keyof typeof logos]}
                alt={p.name}
                class="h-10 w-auto"
                height={80}
              />
            </div>
            <p class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full bg-secondary-soft py-2 pr-3.5 pl-3 text-label text-secondary">
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M12 2l7 3v6c0 5-3.5 9-7 11-3.5-2-7-6-7-11V5l7-3z"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
                <path
                  d="M8.5 12l2.5 2.5 4.5-5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              Partner exclusivo
            </p>
          </div>
          <h3 class="text-h3">Partner autorizado {p.name}</h3>
          <ul class="flex flex-col gap-3">
            {p.benefits.map((b) => (
              <li class="flex gap-2.5">
                <svg
                  class="size-5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" class="fill-primary-soft" />
                  <path
                    d="M8 12.5l2.7 2.7L16 9.8"
                    class="stroke-primary"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {b}
              </li>
            ))}
          </ul>
          <a
            href={p.cta.href}
            class="group inline-flex items-center gap-1.5 self-start text-label text-primary transition-transform duration-100 ease-out active:scale-[0.98]"
          >
            {p.cta.label}
            <svg
              class="size-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </Section>
</div>
